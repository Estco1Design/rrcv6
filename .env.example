# Verified PUBLIC contacts. Set values before building (NEXT_PUBLIC_* is embedded at build time).
NEXT_PUBLIC_RRC_TELEGRAM=rrc_support
NEXT_PUBLIC_RRC_EMAIL=
NEXT_PUBLIC_RRC_VK=
NEXT_PUBLIC_SITE_URL=https://richrussiancommunity.com

# Closed level uses the account session; invitation codes are not required.

# Server-side customer accounts (Node 24). Keep closed until hosting and operator details are ready.
RRC_ACCOUNT_SIGNUPS=0
RRC_ACCOUNT_DB_PATH=var/accounts.sqlite
# Separate token for /studio/clients. At least 32 random characters, never NEXT_PUBLIC.
RRC_ACCOUNT_ADMIN_TOKEN=

# Set to 1 only behind a trusted proxy that replaces client-supplied forwarding headers.
RRC_TRUST_PROXY=0
