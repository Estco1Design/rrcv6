{
  "name": "workspace",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:lan": "node scripts/get-local-ip.js && next dev --hostname 0.0.0.0 --port 3000",
    "build": "next build",
    "start": "next start",
    "lint": "eslint src --max-warnings=0",
    "typecheck": "tsc --noEmit --incremental false",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "test": "node --import tsx --test tests/*.test.ts",
    "setup:local": "node scripts/setup-local.mjs",
    "predev": "node scripts/setup-local.mjs",
    "predev:lan": "node scripts/setup-local.mjs",
    "preview:lan": "node scripts/get-local-ip.js && next start --hostname 0.0.0.0 --port 3000"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "embla-carousel-react": "^8.6.0",
    "framer-motion": "^13.2.0",
    "lucide-react": "^1.41.0",
    "next": "15.5.27",
    "next-view-transitions": "^0.3.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-remove-scroll": "^2.7.2",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.5.4",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "eslint": "^8",
    "eslint-config-next": "15.5.27",
    "postcss": "^8.5.29",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "overrides": {
    "postcss": "^8.5.29",
    "source-map-js": "^1.2.2"
  }
}
